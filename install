#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd -P)"
RUNTIME_DIR="${GSTACK_LITE_HOME:-$HOME/.gstack-lite}"

HOSTS=()

usage() {
  cat <<'USAGE'
Usage:
  ./install --host claude
  ./install --host codex
  ./install --host cursor
  ./install --all

Installs namespaced gstack-lite skill directories:
  gl-office-hours, gl-review, ...

The installer only writes to the selected host skill directory and
$HOME/.gstack-lite for shared runtime assets. Generated project state is
written by skills to the active repository's .gstack-lite directory.
USAGE
}

add_host() {
  case "$1" in
    claude|codex|cursor) HOSTS+=("$1") ;;
    *) echo "Unknown host: $1" >&2; usage >&2; exit 1 ;;
  esac
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --host)
      [ "$#" -ge 2 ] || { echo "Missing value for --host" >&2; exit 1; }
      add_host "$2"
      shift 2
      ;;
    --host=*)
      add_host "${1#--host=}"
      shift
      ;;
    --all)
      HOSTS=(claude codex cursor)
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if [ "${#HOSTS[@]}" -eq 0 ]; then
  HOSTS=(claude)
fi

host_skill_dir() {
  case "$1" in
    claude) printf '%s\n' "${CLAUDE_SKILLS_DIR:-$HOME/.claude/skills}" ;;
    codex) printf '%s\n' "${CODEX_SKILLS_DIR:-${CODEX_HOME:-$HOME/.codex}/skills}" ;;
    cursor) printf '%s\n' "${CURSOR_SKILLS_DIR:-$HOME/.cursor/skills}" ;;
  esac
}

link_dir() {
  local src="$1"
  local dst="$2"
  mkdir -p "$(dirname "$dst")"
  if [ -L "$dst" ]; then
    local current
    current="$(readlink "$dst" 2>/dev/null || true)"
    if [[ "$dst" != "$RUNTIME_DIR/"* && "$current" != "$src" ]]; then
      echo "  warning: $dst already exists as a symlink to $current; leaving it untouched" >&2
      return 0
    fi
    ln -sfn "$src" "$dst"
  elif [ ! -e "$dst" ]; then
    ln -sfn "$src" "$dst"
  else
    echo "  warning: $dst already exists and is not a symlink; leaving it untouched" >&2
  fi
}

link_file() {
  local src="$1"
  local dst="$2"
  mkdir -p "$(dirname "$dst")"
  if [ -L "$dst" ]; then
    ln -sfn "$src" "$dst"
  elif [ ! -e "$dst" ]; then
    ln -sfn "$src" "$dst"
  else
    echo "  warning: $dst already exists and is not a symlink; leaving it untouched" >&2
  fi
}

copy_file() {
  local src="$1"
  local dst="$2"
  mkdir -p "$(dirname "$dst")"
  if [ -L "$dst" ]; then
    rm -f "$dst"
  elif [ -d "$dst" ]; then
    echo "  warning: $dst already exists as a directory; leaving it untouched" >&2
    return 0
  fi
  cp "$src" "$dst"
}

copy_agents() {
  local src="$1"
  local dst="$2"
  [ -d "$src" ] || return 0
  if [ -L "$dst" ]; then
    rm -f "$dst"
  elif [ -e "$dst" ] && [ ! -d "$dst" ]; then
    echo "  warning: $dst already exists and is not a directory; leaving it untouched" >&2
    return 0
  fi
  mkdir -p "$dst"
  cp "$src/openai.yaml" "$dst/openai.yaml"
}

install_runtime() {
  mkdir -p "$RUNTIME_DIR"

  for asset in bin design design-html review qa ETHOS.md; do
    if [ -e "$ROOT/$asset" ] || [ -L "$ROOT/$asset" ]; then
      link_dir "$ROOT/$asset" "$RUNTIME_DIR/$asset"
    fi
  done
}

generate_host_skills() {
  local host="$1"
  local generated_root="$RUNTIME_DIR/generated"
  local out="$generated_root/$host"
  local tmp="$generated_root/.tmp-$host-$$"

  command -v node >/dev/null 2>&1 || {
    echo "node is required to generate gstack-lite skills" >&2
    exit 1
  }

  mkdir -p "$generated_root"
  rm -rf "$tmp"
  node "$ROOT/tools/generate-skills.mjs" --host "$host" --out "$tmp" >/dev/null
  rm -rf "$out"
  mv "$tmp" "$out"
}

install_host_skill() {
  local skill_dir="$1"
  local dst="$2"
  mkdir -p "$(dirname "$dst")"

  if [ -L "$dst" ]; then
    local current
    current="$(readlink "$dst" 2>/dev/null || true)"
    case "$current" in
      "$skill_dir"|"$ROOT"/skills/*|"$RUNTIME_DIR"/generated/*/gl-*)
        rm -f "$dst"
        ;;
      *)
        echo "  warning: $dst already exists as a symlink to $current; leaving it untouched" >&2
        return 0
        ;;
    esac
  elif [ -e "$dst" ] && [ ! -d "$dst" ]; then
    echo "  warning: $dst already exists and is not a directory; leaving it untouched" >&2
    return 0
  fi

  mkdir -p "$dst"
  copy_file "$skill_dir/SKILL.md" "$dst/SKILL.md"
  link_file "$skill_dir/ETHOS.md" "$dst/ETHOS.md"
  if [ -d "$skill_dir/agents" ]; then
    copy_agents "$skill_dir/agents" "$dst/agents"
  fi
}

install_host() {
  local host="$1"
  local skills_dir
  skills_dir="$(host_skill_dir "$host")"
  mkdir -p "$skills_dir"
  generate_host_skills "$host"

  local generated_dir="$RUNTIME_DIR/generated/$host"

  local linked=()
  for skill_dir in "$generated_dir"/gl-*; do
    [ -f "$skill_dir/SKILL.md" ] || continue
    local name
    name="$(basename "$skill_dir")"
    install_host_skill "$skill_dir" "$skills_dir/$name"
    linked+=("$name")
  done

  echo "gstack-lite ready ($host)"
  echo "  skills: $skills_dir"
  echo "  generated: $generated_dir"
  echo "  runtime: $RUNTIME_DIR"
  echo "  commands: ${linked[*]}"
}

install_runtime
for host in "${HOSTS[@]}"; do
  install_host "$host"
done

if command -v gstack-browser >/dev/null 2>&1; then
  echo "note: browser CLI on PATH: $(command -v gstack-browser)"
else
  echo "note: gstack-browser is not on PATH. Install it with: npm i -g gstack-browser"
fi

if [ ! -x "$RUNTIME_DIR/design/dist/design" ]; then
  echo "note: design binary not present at $RUNTIME_DIR/design/dist/design; design skills will use text, wireframes, and available screenshots."
fi
